// Lint steps for a uwiki vault, tools pinned in mise.toml.
// Page steps take the files uwiki reads: `uwiki ls` drops the ones uwiki.toml excludes,
// so markdownlint, typos, Vale and lychee check the same pages uwiki check and the HTML page do.
// Hygiene, shellcheck and secrets steps take every file, they are about the repo, not the vault.
amends "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.12.0/hk@2.12.0#/Builtins.pkl"

fail_fast = false                         // report what every step finds, not the first one only
exclude = List("tests/fixtures/**")       // test data, kept byte for byte

local pages = List("**/*.md")
local uwikiConfig = List("**/*.md", "uwiki.toml", "pyproject.toml")

// cmd over the given pages the vault here reads, nothing when it reads none of them
local function overPages(cmd: String): String = "uwiki ls -z . --only {{files}} | xargs -0 -r \(cmd)"

local steps = new Mapping<String, Step> {
  // pages
  // links, front matter schema, orphans, mentions, refs: the whole vault, a link breaks from either end
  ["uwiki"] {
    glob = uwikiConfig
    check = "uwiki check ."
  }
  // structure: heading order, list style, fences; rules in .markdownlint.yaml
  ["markdownlint"] {
    glob = pages
    check = overPages("markdownlint-cli2")
    fix = overPages("markdownlint-cli2 --fix")
  }
  // misspellings typos knows for sure; jargon allowed in _typos.toml
  ["typos"] {
    glob = pages
    check = overPages("typos")
    fix = overPages("typos --write-changes")
  }
  // prose: rules and vocabulary in .vale.ini and .vale/; style packages fetched once by vale sync
  ["vale"] {
    glob = pages + List(".vale.ini")
    check = "{ [ -d .vale/styles/proselint ] || vale sync >/dev/null; } && " + overPages("vale --no-wrap")
  }

  // hygiene, every file
  ["trailing-whitespace"] = Builtins.trailing_whitespace
  ["newlines"] = Builtins.newlines
  ["mixed-line-ending"] = Builtins.mixed_line_ending
  ["byte-order-marker"] = Builtins.byte_order_marker
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["case-conflict"] = Builtins.check_case_conflict    // Page.md and page.md are one file on macOS and Windows
  ["large-files"] = Builtins.check_added_large_files  // attachments over 500 kB
  ["symlinks"] = Builtins.check_symlinks
  ["shellcheck"] = Builtins.shellcheck               // tasks.sh and other shell scripts

  // secrets in the working tree, untracked files too; rules and allowlist in .gitleaks.toml when needed
  ["gitleaks"] {
    glob = List("**/*")
    check = "gitleaks dir --redact --no-banner ."
  }
}

hooks {
  ["check"] { steps = outer.steps }
  ["fix"] {
    fix = true
    steps = outer.steps
  }
  // checks staged files, never rewrites them: `mise run fix` does, `fix = true` here would and stage the result
  ["pre-commit"] {
    steps = (outer.steps) {
      ["gitleaks"] { check = "gitleaks git --pre-commit --staged --redact --no-banner" }
    }
  }
  // external links alive: network and other people's servers, so on demand or on a schedule, never a gate
  ["links"] {
    steps {
      ["lychee"] {
        glob = pages
        check = overPages("lychee --config lychee.toml")
      }
    }
  }
  // secrets anywhere in git history, a leak stays there after its fix; slower, on demand or on a schedule
  ["secrets"] {
    steps {
      ["gitleaks-history"] {
        glob = List("**/*")
        check = "gitleaks git --redact --no-banner"
      }
    }
  }
}
